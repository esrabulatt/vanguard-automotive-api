# WhatsApp bildirimleri (Meta WhatsApp Cloud API)
# Bu dosyayı .env adıyla kopyalayıp değerleri doldurun. .env Git'e eklenmez.

# Meta Business > WhatsApp > API Setup sayfasındaki erişim anahtarı (kalıcı "System User" anahtarı önerilir)
WHATSAPP_TOKEN=
# Aynı sayfadaki "Phone number ID" (telefon numarasının kendisi değil)
WHATSAPP_PHONE_NUMBER_ID=
# Bildirimin gideceği satış ekibi numaraları; ülke koduyla, virgülle ayrılmış
WHATSAPP_NOTIFY_TO=905321234567
# Onaylı mesaj şablonunun adı (önerilir). Boş bırakılırsa düz metin gönderilir;
# düz metin yalnızca alıcı son 24 saat içinde işletme numarasına yazmışsa iletilir.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=tr
